<!-- Per-user installer: no administrator rights, installs to %LOCALAPPDATA%\Programs\NeoChat.
     Wizard: welcome, desktop shortcut option, progress, finish with "Открыть NeoChat". -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="NeoChat" Manufacturer="NeoChat" Version="$(var.Version)" UpgradeCode="{39508339-7555-4184-817E-4ADDFA033F65}"
           Scope="perUser" Compressed="yes" Language="1049" Codepage="1251">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Уже установлена более новая версия NeoChat." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="neochat.ico" SourceFile="neochat.ico" />
    <Property Id="ARPPRODUCTICON" Value="neochat.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="NeoChat" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StageDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{97A0F763-CAD3-42C7-B166-37AA582E1191}">
        <Shortcut Id="NeoChatShortcut" Name="NeoChat" Target="[INSTALLFOLDER]neochat.exe" WorkingDirectory="INSTALLFOLDER" Icon="neochat.ico" />
        <RemoveFolder Id="CleanInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\NeoChat\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Property Id="DESKTOPSHORTCUT" Value="1" />
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{4C0E2B57-2A8D-4C55-9C2F-7B1E6D3A9F10}" Condition="DESKTOPSHORTCUT = 1">
        <Shortcut Id="NeoChatDesktopShortcut" Name="NeoChat" Target="[INSTALLFOLDER]neochat.exe" WorkingDirectory="INSTALLFOLDER" Icon="neochat.ico" />
        <RegistryValue Root="HKCU" Key="Software\NeoChat\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="NeoChat">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Finish page: launch the app when the box stays checked. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Открыть NeoChat" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]neochat.exe" After="CostFinalize" Sequence="both" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />
    <!-- The in-app updater runs `msiexec /i ... /passive LAUNCHAPP=1`: start the new build when done. -->
    <CustomAction Id="RelaunchAfterUpdate" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RelaunchAfterUpdate" After="InstallFinalize" Condition="LAUNCHAPP = 1 AND NOT REMOVE" />
    </InstallExecuteSequence>

    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />

    <UI Id="NeoChatUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />

      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="8" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Параметры" />
        <Control Id="Description" Type="Text" X="25" Y="24" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Ярлык в меню «Пуск» создаётся всегда." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Desktop" Type="CheckBox" X="25" Y="64" Width="320" Height="17" Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="Добавить ярлык на рабочий стол" />
        <Control Id="Taskbar" Type="Text" X="25" Y="92" Width="320" Height="40" NoPrefix="yes"
                 Text="Чтобы закрепить NeoChat на панели задач, после установки щёлкните значок приложения на панели задач правой кнопкой и выберите «Закрепить на панели задач»." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="156" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Install" Type="PushButton" X="216" Y="243" Width="80" Height="17" Default="yes" Text="!(loc.VerifyReadyDlgInstall)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Package>
</Wix>
