{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeoChat v1 send request",
  "description": "Proposed body of POST /v1/conversations/{id}/messages. UUID uniqueness by target_device_id, decoded ciphertext size, authentication, membership, roster signatures and E2EE validity require server/client checks beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "client_message_id", "conversation_revision", "recipient_set_revision", "recipients", "attachment_ids"],
  "properties": {
    "version": {"const": 1},
    "client_message_id": {"$ref": "#/$defs/id"},
    "conversation_revision": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "recipient_set_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recipients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 47,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_device_id", "ciphertext"],
        "properties": {
          "target_device_id": {"$ref": "#/$defs/id"},
          "ciphertext": {
            "type": "string",
            "minLength": 4,
            "maxLength": 10924,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "description": "Base64-encoded library envelope, <=8192 decoded bytes. Structural examples do not contain real ciphertext."
          }
        }
      }
    },
    "attachment_ids": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
